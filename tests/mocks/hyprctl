#!/usr/bin/env bash

set -euo pipefail

: "${MOCK_MONITORS:?MOCK_MONITORS is required}"

if [[ ${1:-} == -j && ${2:-} == monitors && ${3:-} == all ]]; then
  cat "$MOCK_MONITORS"
  exit 0
fi

if [[ ${1:-} == dispatch && ${2:-} == focusmonitor ]]; then
  printf 'focusmonitor %s\n' "${3:-}" >>"${MOCK_HYPR_LOG:-/dev/null}"
  exit 0
fi

if [[ ${1:-} == reload ]]; then
  if [[ -n ${MOCK_MONITORS_INITIAL:-} ]]; then
    cp "$MOCK_MONITORS_INITIAL" "$MOCK_MONITORS"
  fi
  exit 0
fi

if [[ ${1:-} == eval ]]; then
  code=${2:-}
  [[ $code == 'hl.monitor({ output = '* ]] || {
    printf 'unexpected eval code: %s\n' "$code" >&2
    exit 2
  }
  fields=${code#'hl.monitor({ output = '}
  connector_json=${fields%%', mode = '*}
  fields=${fields#*', mode = '}
  mode_json=${fields%%', position = '*}
  fields=${fields#*', position = '}
  position_json=${fields%%', scale = '*}
  fields=${fields#*', scale = '}
  scale=${fields%%', transform = '*}
  transform=${fields#*', transform = '}
  transform=${transform%' })'}
  connector=$(jq -r . <<<"$connector_json")
  mode=$(jq -r . <<<"$mode_json")
  position=$(jq -r . <<<"$position_json")

  resolution=${mode%%@*}
  width=${resolution%x*}
  height=${resolution#*x}
  refresh=${mode#*@}

  x=${position%x*}
  y=${position#*x}
  temp="${MOCK_MONITORS}.tmp"
  jq \
    --arg connector "$connector" --argjson width "$width" --argjson height "$height" \
    --argjson refresh "$refresh" --argjson x "$x" --argjson y "$y" --argjson scale "$scale" \
    'map(if .name == $connector then . + {width:$width,height:$height,refreshRate:$refresh,x:$x,y:$y,scale:$scale} else . end)' \
    "$MOCK_MONITORS" >"$temp"
  mv "$temp" "$MOCK_MONITORS"
  printf '%s\n' "$code" >>"${MOCK_HYPR_LOG:-/dev/null}"
  printf 'ok\n'
  exit 0
fi

printf 'unexpected hyprctl arguments: %s\n' "$*" >&2
exit 2
